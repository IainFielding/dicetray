#!/bin/sh
#
# .githooks/commit-msg — rejects commit messages carrying AI-agent attribution.
#
# Enable with: git config core.hooksPath .githooks
#
# Targets attribution constructs — a co-author trailer naming a tool or a tool's address, a
# "Generated with <tool>" footer — rather than casual mentions or people who share a tool's name
# (Co-authored-by: Claude Dupont <claude@example.fr> is a person), so ordinary prose such as
#   "Restore cursor styles to locked document sheets."
#   "Fix duplicate warnings being generated by _computeArmorClass"
# is not blocked.

MSG_FILE="$1"

AI_ATTRIBUTION='(^[[:space:]]*Co-[Aa]uthored-[Bb]y:[[:space:]]*(Claude|Claude Code|Claude Opus[^<]*|Claude Sonnet[^<]*|GitHub Copilot|Copilot|ChatGPT|OpenAI Codex|Codex|Gemini|Cursor|Cursor Agent|Devin AI|Windsurf|Codeium|Tabnine)[[:space:]]*<)|(^[[:space:]]*Co-[Aa]uthored-[Bb]y:.*<[^>]*(noreply@anthropic\.com|noreply@openai\.com|\[bot\]@users\.noreply\.github\.com)>)|(Generated with \[?(Claude Code|GitHub Copilot|Cursor|Codex|Gemini|ChatGPT))|(🤖 Generated)'

# The message as git will record it: without "#" comment lines, and without the diff that
# `git commit -v` appends below the scissors line.
MESSAGE=$(sed -e '/^# -\{24\} >8 -\{24\}$/,$d' "$MSG_FILE" | grep -v '^#')

if printf '%s\n' "$MESSAGE" | grep -qE "$AI_ATTRIBUTION"; then
  echo "-------------------------------------------------------------------" >&2
  echo "commit-msg: AI-agent attribution detected in your commit message." >&2
  echo "" >&2
  echo "Offending line(s):" >&2
  printf '%s\n' "$MESSAGE" | grep -nE "$AI_ATTRIBUTION" | sed 's/^/    /' >&2
  echo "" >&2
  echo "This project does not carry AI tool attribution in commit history." >&2
  echo "Please remove the line(s) above and commit again." >&2
  echo "-------------------------------------------------------------------" >&2
  exit 1
fi

exit 0
